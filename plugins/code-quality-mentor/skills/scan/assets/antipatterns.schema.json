{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/se-uhd/code-quality-mentor/plugins/code-quality-mentor/skills/scan/assets/antipatterns.schema.json",
  "title": "Antipattern and Code Smell Catalog",
  "type": "object",
  "required": ["version", "lastUpdated", "sources", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "title", "url"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id", "name", "family", "description",
        "llm_detection_signals", "refactoring",
        "seeded_from", "canonical_references"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "family": {
          "type": "string",
          "enum": [
            "Bloaters",
            "OO Abusers",
            "Change Preventers",
            "Dispensables",
            "Couplers",
            "Architecture"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "llm_detection_signals": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "language_notes": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "refactoring": { "type": "string", "minLength": 1 },
        "pmd_overlap": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "seeded_from": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "canonical_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/canonical_reference" }
        }
      }
    },
    "canonical_reference": {
      "type": "object",
      "required": ["type", "title", "url"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["book", "paper", "talk", "web", "tool_docs"]
        },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "section": { "type": "string" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    }
  }
}
